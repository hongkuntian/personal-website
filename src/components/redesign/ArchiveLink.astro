---
import type { Design } from "../../data/redesigns"
interface Props {
  design: Design
}
const { design } = Astro.props
---

<div class="archive-link">
  <a href={`/redesigns/${design}/archive/`}>Earlier projects ↗</a>
</div>
<style>
  .archive-link {
    margin-top: 32px;
    font:
      13px/1.5 "DM Sans Variable",
      sans-serif;
    opacity: 0.75;
  }
  .archive-link a {
    color: inherit;
    text-underline-offset: 3px;
  }
  .archive-link:hover {
    opacity: 1;
  }
</style>
