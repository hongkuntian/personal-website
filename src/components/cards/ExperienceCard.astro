---
import type { ExperienceEntry } from "../../types/content"
import { formatDateRange } from "../../utils/content"
import styles from "./ExperienceCard.module.css"

interface Props {
  entry: ExperienceEntry
}

const { entry } = Astro.props
---

<article class={styles.card}>
  <div class={styles.header}>
    <div>
      <p class={styles.company}>{entry.company}</p>
      <h3 class={styles.role}>
        <a href={`/experience/${entry.slug}/`}>{entry.role}</a>
      </h3>
    </div>
    <p class={styles.date}>{formatDateRange(entry.start, entry.end)}</p>
  </div>

  <p class={styles.summary}>{entry.summary}</p>

  <ul class={styles.highlights}>
    {entry.highlights.map((highlight) => (
      <li>{highlight}</li>
    ))}
  </ul>

  <div class="tagList">
    {entry.tech.map((item) => (
      <span class="tag">{item}</span>
    ))}
  </div>

  <div class={styles.footer}>
    <span class={styles.location}>{entry.location}</span>
    <a class={styles.cta} href={`/experience/${entry.slug}/`}>
      View details
    </a>
  </div>
</article>
