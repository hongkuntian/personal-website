---
import { Image } from "astro:assets"
import BaseLayout from "../layouts/BaseLayout.astro"
import AwsCareer from "../components/AwsCareer.astro"
import WorkList from "../components/WorkList.astro"
import portrait from "../assets/profile-2026.png"
import { profile } from "../data/profile"
import { experienceSummary, educationSummary } from "../data/site-content"
---

<BaseLayout
  meta={{
    title: "Hong Kun Tian | Software Engineer at AWS",
    description:
      "I'm Hong Kun, a software engineer at AWS Step Functions in Vancouver. Selected work in workflow APIs, production infrastructure, and engineering tools.",
    path: "/",
    absoluteTitle: true,
  }}
>
  <section class="personal-intro">
    <div class="salutation">
      <h1>Hi, I'm<br /><em>Hong Kun.</em></h1>
      <Image
        src={portrait}
        alt="Hong Kun Tian"
        width={400}
        height={450}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <p class="lead">
      I'm a software engineer at AWS Step Functions, based in Vancouver.
    </p>
    <p>
      I work on workflow APIs, production infrastructure, and tools for
      engineers. My scope includes alarm infrastructure, the JSONata launch,
      regional feature expansion, and production incident response.
    </p>
  </section>
  <span id="projects" class="anchor-alias" aria-hidden="true"></span>
  <section id="work" class="home-work">
    <h2>Selected AWS work</h2><WorkList />
  </section>
  <span id="experience" class="anchor-alias" aria-hidden="true"></span>
  <section id="about" class="home-experience">
    <h2>AWS experience</h2><p>{experienceSummary}</p><AwsCareer />
    <p class="education">{educationSummary}</p>
    <p><a href={profile.resumeUrl}>View my résumé →</a></p>
  </section>
</BaseLayout>
