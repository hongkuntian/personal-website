---
import { Image } from "astro:assets"
import AwsCareer from "../../components/redesign/AwsCareer.astro"
import ArchiveLink from "../../components/redesign/ArchiveLink.astro"
import portrait from "../../assets/profile-2026.png"
import RedesignLayout from "../../layouts/RedesignLayout.astro"
import { profile } from "../../data/profile"
import { workNotes } from "../../data/redesigns"
import {
  introduction,
  experienceSummary,
  educationSummary,
} from "../../data/redesign-content"
---

<RedesignLayout design="scrapbook">
  <div class="collection-page">
    <header>
      <a class="logo" href="/redesigns/scrapbook/">hkt.</a><nav
        aria-label="Main navigation"
      >
        <a href="#work">Work</a><a href="#about">Experience</a><a
          href={profile.resumeUrl}>Résumé</a
        ><a href="#contact">Contact</a>
      </nav>
    </header>
    <main id="main">
      <section class="collection-hero">
        <div>
          <p class="name">Hong Kun Tian</p><h1>
            Software engineer.<br /><span>AWS Step Functions.</span>
          </h1><p class="intro">{introduction}</p><a
            class="text-link"
            href="#work">AWS work ↓</a
          >
        </div><figure>
          <Image
            src={portrait}
            alt="Hong Kun Tian"
            width={650}
            height={700}
            loading="eager"
          /><figcaption>
            <span>AWS Step Functions</span><span
              >Software Development Engineer II</span
            >
          </figcaption>
        </figure>
      </section>
      <section id="work" class="work-section">
        <div class="section-title">
          <h2>Selected AWS work</h2><span>AWS Step Functions</span>
        </div><div class="work-grid">
          {
            workNotes.map((work) => (
              <a href={`/redesigns/scrapbook/projects/${work.slug}/`}>
                <>
                  <span class="mono">{work.period}</span>
                  <h3>{work.title}</h3>
                  <p>{work.description}</p>
                  <span class="project-link">Project details ↗</span>
                </>
              </a>
            ))
          }
        </div>
      </section>
      <section id="about" class="about-section">
        <h2>AWS experience</h2><div>
          <p>{experienceSummary}</p><AwsCareer /><p class="education">
            {educationSummary}
          </p><a class="text-link" href={profile.resumeUrl}>View résumé ↗</a>
        </div>
      </section>
      <footer id="contact">
        <p>Open to backend and platform engineering roles.</p><a
          class="contact-title"
          href={`mailto:${profile.email}`}>Contact me ↗</a
        ><div class="footer-line">
          <a href={`mailto:${profile.email}`}>{profile.email}</a><div>
            {
              profile.socialLinks
                .slice(1)
                .map((link) => <a href={link.href}>{link.label} ↗</a>)
            }
          </div>
        </div>
        <ArchiveLink design="scrapbook" />
      </footer>
    </main>
  </div>
</RedesignLayout>
<style>
  :global(body.scrapbook) {
    background: #f9f9f4;
    color: #213c9c;
  }
  .collection-page {
    max-width: 1440px;
    margin: auto;
    padding: 0 64px;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 26px 0;
    border-bottom: 2px solid;
    gap: 25px;
  }
  .logo {
    font-size: 48px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.08em;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 30px;
    font-size: 14px;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
  }
  .collection-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 65px;
    align-items: center;
    padding: 40px 0 45px;
  }
  .name {
    font-size: 18px;
    margin-bottom: 25px;
  }
  h1 {
    font-size: clamp(44px, 4.8vw, 69px);
    font-weight: 750;
    line-height: 1.03;
    letter-spacing: -0.065em;
  }
  h1 span {
    background: #eee4b4;
    padding: 0 8px 3px 0;
  }
  .intro {
    font-size: 17px;
    line-height: 1.8;
    max-width: 580px;
    margin: 28px 0;
  }
  .text-link {
    font-size: 14px;
    padding-bottom: 6px;
    border-bottom: 1px solid;
    text-decoration: none;
  }
  figure {
    border: 1px solid #213c9c45;
  }
  figure img {
    width: 100%;
    height: 325px;
    object-fit: cover;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 16px 20px;
    background: #eee4b4;
    font-size: 14px;
  }
  figcaption span:last-child {
    font-size: 12px;
    color: #36497b;
  }
  .section-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 25px;
    padding: 23px 0;
    border-top: 2px solid;
    border-bottom: 1px solid #213c9c45;
  }
  .section-title > span {
    font-size: 13px;
  }
  h2 {
    font-size: 38px;
    line-height: 1.2;
    letter-spacing: -0.04em;
    font-weight: 650;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
    padding: 30px 0 65px;
  }
  .work-grid > a {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: start;
    border-right: 1px solid #213c9c40;
    padding-right: 30px;
  }
  .work-grid > a:last-child {
    border: 0;
    padding-right: 0;
  }
  .work-grid h3 {
    font-size: 26px;
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin: 18px 0;
  }
  .work-grid p,
  .project-grid p {
    font-size: 16px;
    line-height: 1.75;
    color: #425071;
  }
  .project-link {
    font-size: 14px;
    margin-top: auto;
    padding-top: 24px;
  }
  .work-grid a:hover h3,
  .project-grid a:hover h3 {
    text-decoration: underline;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
    padding: 30px 0 65px;
  }
  .project-grid a {
    text-decoration: none;
  }
  .project-image {
    display: grid;
    place-items: center;
    background: #e6ebee;
    min-height: 220px;
    margin-bottom: 22px;
  }
  .project-grid a:nth-child(2) .project-image {
    background: #eee7d5;
  }
  .project-grid a:nth-child(3) .project-image {
    background: #e5e8df;
  }
  .project-image img {
    width: 110px;
    height: 130px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .project-grid h3 {
    font-size: 25px;
    letter-spacing: -0.035em;
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .about-section {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 50px;
    padding: 40px 0 75px;
    border-top: 2px solid;
  }
  .about-section p {
    font-size: 18px;
    line-height: 1.8;
    margin-bottom: 20px;
    color: #425071;
  }
  footer {
    background: #213c9c;
    color: #f9f9f4;
    margin: 0 -64px;
    padding: 40px 64px 105px;
  }
  footer > p {
    font-size: 15px;
  }
  .contact-title {
    display: block;
    font-size: 65px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.05em;
    margin: 20px 0 35px;
    text-decoration: none;
  }
  .footer-line {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid #ffffff60;
    font-size: 14px;
  }
  .footer-line div {
    display: flex;
    gap: 25px;
  }
  @media (max-width: 900px) {
    .collection-page {
      padding: 0 28px;
    }
    .collection-hero {
      gap: 30px;
    }
    figure img {
      height: 300px;
    }
    h1 {
      font-size: 61px;
    }
    .work-grid,
    .project-grid {
      gap: 22px;
    }
    .work-grid > a {
      padding-right: 20px;
    }
    footer {
      margin: 0 -28px;
      padding-left: 28px;
      padding-right: 28px;
    }
  }
  @media (max-width: 600px) {
    header {
      display: block;
      padding: 22px 0;
    }
    .logo {
      font-size: 40px;
    }
    nav {
      margin-top: 22px;
      flex-wrap: wrap;
      gap: 14px 21px;
      font-size: 13px;
    }
    .collection-hero {
      grid-template-columns: 1fr;
      gap: 38px;
      padding: 38px 0 45px;
    }
    .name {
      font-size: 16px;
      margin-bottom: 18px;
    }
    h1 {
      font-size: clamp(44px, 12vw, 67px);
    }
    .intro {
      font-size: 16px;
      margin: 24px 0;
    }
    figure img {
      height: 350px;
    }
    .section-title {
      align-items: start;
    }
    .section-title h2 {
      font-size: 29px;
    }
    .section-title > span {
      font-size: 11px;
      max-width: 90px;
      text-align: right;
    }
    .work-grid,
    .project-grid {
      grid-template-columns: 1fr;
      padding: 0 0 45px;
      gap: 0;
    }
    .work-grid > a,
    .work-grid > a:last-child {
      border-right: 0;
      border-bottom: 1px solid #213c9c40;
      padding: 24px 0;
    }
    .work-grid h3 {
      font-size: 28px;
      margin: 12px 0;
    }
    .project-grid a {
      padding-top: 27px;
    }
    .project-grid .project-image {
      min-height: 190px;
    }
    .about-section {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 30px 0 50px;
    }
    .about-section p {
      font-size: 16px;
    }
    .contact-title {
      font-size: 44px;
    }
    .footer-line {
      flex-direction: column;
      gap: 20px;
      font-size: 13px;
    }
  }
  .work-grid {
    row-gap: 40px;
  }
  .work-grid > a:nth-child(3n) {
    border: 0;
    padding-right: 0;
  }
  .about-section .education {
    font-size: 15px;
  }
  @media (max-width: 600px) {
    .work-grid {
      row-gap: 0;
    }
    .work-grid > a:nth-child(3n) {
      border-bottom: 1px solid #213c9c40;
      padding: 24px 0;
    }
  }

  figure {
    max-width: 340px;
    width: 100%;
    justify-self: end;
  }
  h1 span {
    background: none;
    padding: 0;
    color: #445781;
  }
  .name {
    margin-bottom: 18px;
  }
  .work-grid > a:nth-child(3n) {
    border-right: 0;
  }
  @media (max-width: 600px) {
    header {
      padding-bottom: 10px;
    }
    nav {
      margin-top: 12px;
    }
    .collection-hero {
      position: relative;
      padding: 25px 0 32px;
      gap: 0;
    }
    .name {
      display: flex;
      align-items: center;
      min-height: 96px;
      padding-right: 105px;
      margin-bottom: 20px;
      font-size: 22px;
    }
    .collection-hero figure {
      position: absolute;
      top: 25px;
      right: 0;
      width: 80px;
      border: 0;
    }
    figure img {
      height: 96px;
      border-radius: 5px;
    }
    figcaption {
      display: none;
    }
    h1 {
      font-size: clamp(38px, 10vw, 52px);
    }
    .intro {
      margin: 20px 0;
    }
  }
</style>
