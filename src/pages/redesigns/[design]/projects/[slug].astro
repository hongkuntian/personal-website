---
import { Image } from "astro:assets"
import RedesignLayout from "../../../../layouts/RedesignLayout.astro"
import { redesigns } from "../../../../data/redesigns"
import { previewProjects as projectEntries } from "../../../../data/redesign-content"
import type { ProjectEntry } from "../../../../types/content"
import type { Design } from "../../../../data/redesigns"
import { profile } from "../../../../data/profile"
export function getStaticPaths() {
  return redesigns.flatMap((design) =>
    projectEntries.map((project) => ({
      params: { design: design.slug, slug: project.slug },
      props: { project, design: design.slug },
    }))
  )
}
interface Props {
  project: ProjectEntry & { period?: string }
  design: Design
}
const { project, design } = Astro.props
const relatedProjects = projectEntries.filter(
  (item) => item.category === project.category
)
const next =
  relatedProjects[
    (relatedProjects.findIndex((item) => item.slug === project.slug) + 1) %
      relatedProjects.length
  ]
const returnPath =
  project.category === "archive"
    ? `/redesigns/${design}/archive/`
    : `/redesigns/${design}/#work`
---

<RedesignLayout design={design} title={`${project.name} | Hong Kun Tian`}>
  <div class:list={["detail-page", `detail-${design}`]}>
    <header>
      <a href={`/redesigns/${design}/`}>← Hong Kun Tian</a><nav
        aria-label="Main navigation"
      >
        <a href={`/redesigns/${design}/#work`}>Work</a><a
          href={`/redesigns/${design}/#about`}>Experience</a
        ><a href={profile.resumeUrl}>Résumé</a><a
          href={`/redesigns/${design}/#contact`}>Contact</a
        >
      </nav>
    </header>
    <main id="main">
      <div class="project-label">
        <span
          >{
            project.category === "archive"
              ? "Personal project"
              : "Selected work / AWS Step Functions"
          }</span
        ><span>{project.period ?? "Project archive"}</span>
      </div><h1>{project.name}</h1><p class="project-intro">
        {project.summary}
      </p>{
        project.image && (
          <figure>
            <Image
              src={project.image}
              alt={project.imageAlt ?? project.name}
              width={420}
              height={300}
            />
          </figure>
        )
      }
      {
        project.descriptionSections.map((section) => (
          <section class="project-section">
            <>
              <h2>{section.title}</h2>
              <div>
                {section.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </>
          </section>
        ))
      }
      <div class="technologies">
        <span>Technologies</span><p>{project.tech.join(" · ")}</p>
      </div>
      {
        project.links.length > 0 && (
          <div class="project-links">
            {project.links.map((link) => (
              <a href={link.url}>{link.label} ↗</a>
            ))}
          </div>
        )
      }
      <footer>
        <a href={returnPath}
          >{
            project.category === "archive"
              ? "← Earlier projects"
              : "← All AWS work"
          }</a
        ><a href={`/redesigns/${design}/projects/${next.slug}/`}
          >Next: {next.name} →</a
        >
      </footer>
    </main>
  </div>
</RedesignLayout>
<style>
  .detail-page {
    --bg: #f5f1e8;
    --ink: #272a22;
    --accent: #a7492d;
    --border: #272a2238;
    --heading: "Instrument Serif", serif;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    padding: 30px max(25px, calc((100vw - 1050px) / 2)) 115px;
  }
  .detail-page header {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    padding-bottom: 25px;
    font-size: 14px;
  }
  .detail-page header a {
    text-decoration: none;
  }
  .detail-page main {
    max-width: 850px;
    margin: 55px auto 0;
  }
  .project-label {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    color: var(--accent);
    font:
      12px/1.5 "Courier New",
      monospace;
    text-transform: uppercase;
  }
  .detail-page h1 {
    font: 400 clamp(45px, 6.4vw, 84px)/1 var(--heading);
    letter-spacing: -0.04em;
    margin: 30px 0;
  }
  .project-intro {
    font-size: 21px;
    line-height: 1.7;
    max-width: 760px;
  }
  .detail-page figure {
    background: color-mix(in srgb, var(--ink) 5%, var(--bg));
    padding: 40px;
    margin: 40px 0;
  }
  .detail-page figure img {
    width: 250px;
    height: 190px;
    object-fit: contain;
    margin: auto;
  }
  .highlights {
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--border);
    margin: 40px 0;
    padding: 30px 0;
  }
  .detail-page h2 {
    font: 400 36px/1.2 var(--heading);
    letter-spacing: -0.02em;
  }
  .highlights ul {
    padding-left: 20px;
    margin-bottom: 0;
  }
  .highlights li {
    padding: 8px 0;
    font-size: 16px;
    line-height: 1.8;
  }
  .project-section {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 40px;
    padding: 30px 0;
    border-bottom: 1px solid var(--border);
  }
  .project-section p {
    line-height: 1.85;
    margin-bottom: 18px;
  }
  .project-section p:last-child {
    margin-bottom: 0;
  }
  .technologies {
    padding: 30px 0;
  }
  .technologies span {
    font:
      12px/1.4 "Courier New",
      monospace;
    text-transform: uppercase;
    color: var(--accent);
  }
  .technologies p {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.8;
  }
  .project-links {
    display: flex;
    gap: 20px;
    margin: 10px 0 35px;
  }
  .project-links a {
    border: 1px solid var(--border);
    padding: 10px 20px;
    text-decoration: none;
  }
  .detail-page footer {
    display: flex;
    justify-content: space-between;
    gap: 35px;
    border-top: 1px solid var(--border);
    padding-top: 30px;
    font-size: 14px;
  }
  .detail-page a:hover {
    color: var(--accent);
  }
  .detail-scrapbook {
    --bg: #f8f6ef;
    --ink: #233eac;
    --accent: #233eac;
    --border: #233eac40;
    --heading: "DM Sans Variable", sans-serif;
  }
  .detail-scrapbook h1 {
    font-weight: 800;
  }
  .detail-scrapbook h2 {
    font-weight: 700;
    font-size: 28px;
  }
  .detail-scrapbook figure {
    background: #f4dc45;
    transform: none;
    border: 1px solid;
    box-shadow: 5px 5px 0 #233eac;
  }
  .detail-poster {
    --bg: #161814;
    --ink: #f2f3ec;
    --accent: #d3e5a7;
    --border: #f2f3ec55;
    --heading: "DM Sans Variable", sans-serif;
  }
  .detail-poster h1 {
    font-weight: 650;
    color: #d3e5a7;
    letter-spacing: -0.065em;
  }
  .detail-poster h2 {
    font-weight: 500;
    font-size: 28px;
  }
  .detail-poster figure {
    background: #d3e5a7;
  }
  .detail-desktop {
    --bg: #f5f2e8;
    --ink: #202921;
    --accent: #3b672d;
    --border: #20292140;
    font-family: "DM Sans Variable", sans-serif;
    border: 18px solid #306e68;
    padding-top: 20px;
  }
  .detail-desktop header {
    background: #e1dfd4;
    padding: 10px;
    border: 1px solid;
  }
  .detail-desktop h1 {
    font-size: 65px;
  }
  .detail-desktop .project-intro {
    font-size: 18px;
  }
  .detail-desktop .project-section p,
  .detail-desktop li {
    font-size: 16px;
  }
  .detail-letter {
    --bg: #faf8f3;
    --ink: #343c43;
    --accent: #315a9a;
    --border: #d9dde0;
    font-family: Georgia, serif;
  }
  .detail-letter main {
    max-width: 690px;
  }
  .detail-letter h1 {
    color: #315a9a;
  }
  .detail-letter .project-section {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .detail-letter p {
    line-height: 1.9;
  }
  .detail-letter header {
    font-family: "DM Sans Variable", sans-serif;
  }
  @media (max-width: 600px) {
    .detail-page {
      padding: 22px 23px 100px;
    }
    .detail-page main {
      margin-top: 35px;
    }
    .project-label {
      font-size: 10px;
    }
    .project-label span:last-child {
      display: none;
    }
    .project-intro {
      font-size: 18px;
    }
    .project-section {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .detail-page h2 {
      font-size: 31px;
    }
    .detail-page footer {
      flex-direction: column;
      gap: 20px;
    }
    .detail-desktop {
      border-width: 8px;
    }
    .detail-desktop h1 {
      font-size: 49px;
    }
  }
  .detail-page header {
    gap: 25px;
    align-items: center;
    flex-wrap: wrap;
  }
  .detail-page header nav {
    display: flex;
    gap: 22px;
  }
  .detail-page .project-intro {
    margin-bottom: 30px;
  }
  @media (max-width: 600px) {
    .detail-page header {
      gap: 18px;
    }
    .detail-page header nav {
      flex-wrap: wrap;
      gap: 20px;
      font-size: 13px;
    }
  }
</style>
