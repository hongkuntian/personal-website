---
import RedesignLayout from "../../layouts/RedesignLayout.astro"
import { redesigns } from "../../data/redesigns"
---

<RedesignLayout title="Five redesigns | Hong Kun Tian">
  <div class="gallery-page">
    <header>
      <span>HONG KUN TIAN / DESIGN EXPLORATIONS</span><a href="/"
        >View the original ↗</a
      >
    </header><main id="main">
      <div class="gallery-intro">
        <h1>Five portfolio<br /><em>directions.</em></h1><p>
          Compare the layouts, navigation, and project pages.<br />Use the
          Compare designs menu to move between designs.
        </p>
      </div><div class="design-grid">
        {
          redesigns.map((design) => (
            <a
              class={`design-card design-${design.slug}`}
              href={`/redesigns/${design.slug}/`}
            >
              <>
                <div class="preview" style={`background:${design.color}`}>
                  <img
                    src={`/redesign-previews/${design.slug}.png`}
                    alt={`Homepage preview of ${design.name}`}
                    width="1440"
                    height="1000"
                    loading="eager"
                  />
                </div>
                <div class="card-title">
                  <>
                    <span>{design.number}</span>
                    <h2>{design.name}</h2>
                    <span class="card-arrow">↗</span>
                  </>
                </div>
                <p>{design.description}</p>
              </>
            </a>
          ))
        }
      </div><footer>
        <span>Five working concepts, each with its own project pages.</span><a
          href="/">Original website ↗</a
        >
      </footer>
    </main>
  </div>
</RedesignLayout>
<style>
  :global(body.gallery) {
    background: #f0efeb;
    color: #20221f;
  }
  .gallery-page {
    max-width: 1600px;
    padding: 30px 50px 45px;
    margin: auto;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #20221f40;
    padding-bottom: 25px;
    gap: 20px;
    font-size: 12px;
    letter-spacing: 0.05em;
  }
  header a {
    letter-spacing: 0;
    text-decoration: none;
  }
  .gallery-intro {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
    padding: 65px 0 50px;
  }
  h1 {
    font-size: clamp(40px, 4.6vw, 66px);
    line-height: 1.08;
    letter-spacing: -0.055em;
    font-weight: 500;
  }
  h1 em {
    font-family: "Instrument Serif", serif;
    font-size: 1.2em;
    color: #b14e31;
    font-weight: 400;
  }
  .gallery-intro p {
    font-size: 14px;
    color: #62665f;
    line-height: 1.8;
    padding-bottom: 4px;
  }
  .design-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 50px 28px;
  }
  .design-card {
    grid-column: span 2;
    text-decoration: none;
  }
  .design-card:nth-child(-n + 2) {
    grid-column: span 3;
  }
  .preview {
    aspect-ratio: 1.44;
    overflow: hidden;
    border: 1px solid #20221f20;
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }
  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .design-card:hover .preview {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px #20221f20;
  }
  .card-title {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 20px;
  }
  .card-title > span:first-child {
    font:
      12px "Courier New",
      monospace;
    color: #767a71;
  }
  .card-title h2 {
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.035em;
    font-weight: 500;
  }
  .card-arrow {
    margin-left: auto;
    font-size: 26px;
  }
  .design-card > p {
    font-size: 14px;
    line-height: 1.7;
    color: #62665f;
    margin: 12px 0 0 30px;
    max-width: 460px;
  }
  footer {
    margin-top: 65px;
    padding-top: 25px;
    border-top: 1px solid #20221f40;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 12px;
    color: #62665f;
  }
  @media (max-width: 900px) {
    .gallery-page {
      padding: 25px;
    }
    .gallery-intro {
      display: block;
      padding-top: 45px;
    }
    .gallery-intro p {
      margin-top: 25px;
    }
    .design-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .design-card,
    .design-card:nth-child(-n + 2) {
      grid-column: span 1;
    }
    .card-title h2 {
      font-size: 21px;
    }
  }
  @media (max-width: 550px) {
    header {
      font-size: 10px;
    }
    .gallery-intro {
      padding: 35px 0;
    }
    h1 {
      font-size: 39px;
    }
    .design-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }
    .card-title {
      margin-top: 14px;
    }
    .design-card > p {
      margin-top: 9px;
    }
    footer {
      flex-direction: column;
    }
  }
</style>
