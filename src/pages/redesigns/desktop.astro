---
import { Image } from "astro:assets"
import AwsCareer from "../../components/redesign/AwsCareer.astro"
import ArchiveLink from "../../components/redesign/ArchiveLink.astro"
import portrait from "../../assets/profile-2026.png"
import RedesignLayout from "../../layouts/RedesignLayout.astro"
import { profile } from "../../data/profile"
import { workNotes } from "../../data/redesigns"
import {
  introduction,
  experienceSummary,
  educationSummary,
} from "../../data/redesign-content"
---

<RedesignLayout design="desktop">
  <header class="workspace-header">
    <a href="/redesigns/desktop/">Hong Kun Tian</a><span
      >Software engineer / Vancouver, BC</span
    >
  </header>
  <main id="main" class="workspace">
    <aside class="section-index">
      <span class="index-title">PORTFOLIO</span><nav
        aria-label="Main navigation"
      >
        <a href="#work">Work</a><a href="#about">Experience</a><a
          href={profile.resumeUrl}>Résumé</a
        ><a href="#contact">Contact</a>
      </nav><div class="index-links">
        {
          profile.socialLinks
            .slice(1)
            .map((link) => <a href={link.href}>{link.label} ↗</a>)
        }
      </div>
    </aside>
    <div class="workspace-content">
      <section class="window introduction">
        <div class="window-title">
          <span>Hong Kun Tian</span><span>Vancouver, BC</span>
        </div><div class="intro-content">
          <div>
            <p class="role">Software Development Engineer II</p><h1>
              Hong Kun Tian
            </h1><p>{introduction}</p>
          </div><Image
            src={portrait}
            alt="Hong Kun Tian"
            width={320}
            height={370}
            loading="eager"
          />
        </div>
      </section>
      <section id="work" class="window">
        <div class="window-title">
          <h2>Selected AWS work</h2><span>AWS Step Functions</span>
        </div><div class="work-list">
          {
            workNotes.map((work, i) => (
              <a href={`/redesigns/desktop/projects/${work.slug}/`}>
                <>
                  <span class="work-number">0{i + 1}</span>
                  <div>
                    <>
                      <h3>{work.title}</h3>
                      <p>{work.description}</p>
                    </>
                  </div>
                  <span class="work-arrow">↗</span>
                </>
              </a>
            ))
          }
        </div>
      </section>
      <section id="about" class="window">
        <div class="window-title">
          <h2>AWS experience</h2><span>Experience & education</span>
        </div><div class="about-content">
          <p>{experienceSummary}</p><AwsCareer /><p class="education">
            {educationSummary}
          </p><a href={profile.resumeUrl}>View résumé ↗</a>
        </div>
      </section>
      <footer id="contact" class="window">
        <div class="window-title">
          <h2>Contact</h2><span>Hong Kun Tian</span>
        </div><div class="about-content">
          <p>I'm open to backend and platform engineering roles.</p><a
            href={`mailto:${profile.email}`}>{profile.email}</a
          ><div class="contact-links">
            {
              profile.socialLinks
                .slice(1)
                .map((link) => <a href={link.href}>{link.label} ↗</a>)
            }
          </div>
        </div>
        <ArchiveLink design="desktop" />
      </footer>
    </div>
  </main>
</RedesignLayout>
<style>
  :global(body.desktop) {
    background: #315b55;
    color: #26372e;
  }
  .workspace-header {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    align-items: center;
    background: #edeee6;
    padding: 20px 36px;
    border-bottom: 2px solid #243c32;
  }
  .workspace-header a {
    font-weight: 650;
    text-decoration: none;
    font-size: 18px;
    letter-spacing: -0.025em;
  }
  .workspace-header > span {
    font:
      12px/1.5 "Courier New",
      monospace;
  }
  .workspace {
    max-width: 1400px;
    margin: auto;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 40px;
    padding: 40px 36px 110px;
  }
  .section-index {
    position: sticky;
    top: 30px;
    align-self: start;
    color: #eff1e7;
  }
  .index-title {
    font:
      12px "Courier New",
      monospace;
    letter-spacing: 0.08em;
    color: #c1d4c8;
  }
  .section-index nav {
    display: flex;
    flex-direction: column;
    margin-top: 26px;
    gap: 4px;
  }
  .section-index nav a {
    font-size: 15px;
    text-decoration: none;
    padding: 10px 0;
    border-bottom: 1px solid #ffffff30;
  }
  .section-index nav a:hover {
    color: #f3df89;
  }
  .index-links {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 36px;
    font-size: 13px;
  }
  .workspace-content {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }
  .window {
    background: #f5f4ec;
    border: 1px solid #193a2d;
    box-shadow: 4px 4px 0 #214237;
    scroll-margin-top: 25px;
  }
  .window-title {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    border-bottom: 1px solid #647866;
    padding: 12px 22px;
    background: #e0e4d8;
    font:
      12px/1.4 "Courier New",
      monospace;
  }
  .window-title h2 {
    font: inherit;
    font-weight: bold;
  }
  .window-title > span:last-child {
    color: #586951;
  }
  .intro-content {
    display: grid;
    grid-template-columns: 1fr 155px;
    gap: 30px;
    align-items: center;
    padding: 34px;
  }
  .role {
    font:
      12px/1.6 "Courier New",
      monospace;
    color: #597151;
  }
  h1 {
    font:
      400 68px/1.05 "Instrument Serif",
      serif;
    letter-spacing: -0.025em;
    margin: 20px 0;
  }
  .intro-content p:not(.role) {
    font-size: 17px;
    line-height: 1.8;
    max-width: 580px;
  }
  .intro-content img {
    width: 155px;
    height: 190px;
    object-fit: cover;
    filter: none;
  }
  .work-list {
    padding: 0 28px;
  }
  .work-list > a {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) 22px;
    gap: 20px;
    text-decoration: none;
    padding: 25px 0;
    border-bottom: 1px solid #c6cdbe;
  }
  .work-list > a:last-child {
    border: 0;
  }
  .work-number {
    font:
      12px/1.6 "Courier New",
      monospace;
    color: #667b5f;
  }
  h3 {
    font-size: 21px;
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  .work-list p {
    font-size: 16px;
    line-height: 1.75;
    margin-top: 10px;
    max-width: 680px;
    color: #56604f;
  }
  .work-arrow {
    font-size: 24px;
  }
  .work-list a:hover h3,
  .project-list a:hover h3 {
    text-decoration: underline;
  }
  .project-list {
    padding: 5px 28px;
  }
  .project-list > a {
    display: grid;
    grid-template-columns: 50px minmax(0, 1fr) 20px;
    gap: 20px;
    text-decoration: none;
    align-items: center;
    padding: 22px 0;
    border-bottom: 1px solid #c6cdbe;
  }
  .project-list > a:last-child {
    border: 0;
  }
  .project-list img {
    width: 45px;
    height: 45px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .project-list h3 {
    font-size: 18px;
  }
  .project-list p {
    font-size: 15px;
    line-height: 1.65;
    color: #56604f;
    margin-top: 5px;
  }
  .about-content {
    padding: 25px 30px;
  }
  .about-content p {
    font-size: 17px;
    line-height: 1.8;
    margin-bottom: 18px;
    max-width: 750px;
  }
  .about-content > a {
    font-size: 15px;
  }
  .contact-links {
    display: flex;
    gap: 25px;
    font-size: 14px;
    margin-top: 24px;
  }
  @media (max-width: 950px) {
    .workspace {
      grid-template-columns: 145px minmax(0, 1fr);
      gap: 25px;
      padding: 30px 25px 100px;
    }
    .intro-content {
      grid-template-columns: 1fr 110px;
      padding: 25px;
      gap: 22px;
    }
    .intro-content img {
      width: 110px;
      height: 145px;
    }
    h1 {
      font-size: 54px;
    }
    .window-title {
      padding: 12px 20px;
    }
  }
  @media (max-width: 650px) {
    .workspace-header {
      padding: 18px 20px;
      display: block;
    }
    .workspace-header > span {
      display: block;
      margin-top: 7px;
      font-size: 11px;
    }
    .workspace {
      grid-template-columns: 1fr;
      gap: 25px;
      padding: 24px 18px 100px;
    }
    .section-index {
      position: static;
    }
    .index-title,
    .index-links {
      display: none;
    }
    .section-index nav {
      margin: 0;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 10px 20px;
    }
    .section-index nav a {
      padding: 0 0 7px;
      font-size: 15px;
    }
    .workspace-content {
      gap: 22px;
    }
    .window-title {
      padding: 11px 16px;
      font-size: 11px;
    }
    .window-title > span:last-child {
      font-size: 10px;
    }
    .intro-content {
      display: flex;
      flex-direction: column-reverse;
      align-items: start;
      padding: 24px;
      gap: 22px;
    }
    .intro-content img {
      width: 88px;
      height: 100px;
    }
    h1 {
      font-size: 50px;
      margin: 16px 0;
    }
    .role {
      font-size: 11px;
    }
    .intro-content p:not(.role) {
      font-size: 16px;
    }
    .work-list {
      padding: 0 18px;
    }
    .work-list > a {
      grid-template-columns: 18px minmax(0, 1fr) 15px;
      gap: 10px;
      padding: 23px 0;
    }
    .work-list h3 {
      font-size: 21px;
    }
    .work-list p {
      font-size: 15px;
    }
    .project-list {
      padding: 0 18px;
    }
    .project-list > a {
      grid-template-columns: 32px minmax(0, 1fr) 12px;
      gap: 13px;
    }
    .project-list img {
      width: 32px;
      height: 32px;
    }
    .project-list p {
      font-size: 14px;
    }
    .about-content {
      padding: 23px;
    }
    .about-content p {
      font-size: 16px;
    }
    .about-content > a {
      font-size: 14px;
      overflow-wrap: anywhere;
    }
  }
  .about-content .education {
    font-size: 15px;
    color: #56604f;
  }
  footer :global(.archive-link) {
    margin: 0 30px 26px;
  }

  .window {
    box-shadow: none;
    border-color: #42655a;
    border-radius: 7px;
    overflow: hidden;
  }
  .window-title {
    font-family: "DM Sans Variable", sans-serif;
    font-size: 14px;
  }
  .intro-content img {
    border-radius: 6px;
  }
  .role {
    font:
      14px/1.5 "DM Sans Variable",
      sans-serif;
    color: #466043;
  }
  .work-number {
    color: #506749;
    font-size: 13px;
  }
  .work-list p {
    font-size: 16px;
  }
  @media (max-width: 650px) {
    .workspace {
      padding-top: 12px;
      gap: 16px;
    }
    .intro-content {
      display: block;
      position: relative;
      padding: 22px;
    }
    .intro-content .role {
      max-width: calc(100% - 92px);
      min-height: 66px;
      display: flex;
      align-items: center;
    }
    .intro-content img {
      position: absolute;
      top: 20px;
      right: 22px;
      width: 70px;
      height: 84px;
    }
    h1 {
      font-size: clamp(38px, 10vw, 50px);
      margin: 22px 0 16px;
    }
    .window-title {
      font-size: 14px;
    }
  }
</style>
