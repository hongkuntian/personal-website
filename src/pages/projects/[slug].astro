---
import { Image } from "astro:assets"
import { profile } from "../../data/profile"
import { projectEntries } from "../../data/projects"
import BaseLayout from "../../layouts/BaseLayout.astro"

export function getStaticPaths() {
  return projectEntries.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

const { project } = Astro.props
const sectionLabel =
  project.category === "selected-work" ? "Selected Work" : "Archive Project"
---

<BaseLayout
  meta={{
    title: project.name,
    description: project.summary,
    path: `/projects/${project.slug}/`,
  }}
>
  <article class="detailShell">
    <p class="eyebrow">{sectionLabel}</p>
    <h1>{project.name}</h1>
    <p class="detailLead">{project.tagline}</p>
    <p class="detailSummary">{project.summary}</p>

    {
      project.image && project.imageAlt && (
        <div class="detailMedia">
          <Image
            src={project.image}
            alt={project.imageAlt}
            widths={[320]}
            sizes="(max-width: 900px) 70vw, 320px"
            class="detailImage"
          />
        </div>
      )
    }

    <div class="tagList">
      {project.tech.map((item) => <span class="tag">{item}</span>)}
    </div>

    {
      project.highlights && (
        <section class="detailSection">
          <h2>Highlights</h2>
          <ul class="detailList">
            {project.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      project.descriptionSections.map((section) => (
        <section class="detailSection">
          <h2>{section.title}</h2>
          <div class="stack">
            {section.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      ))
    }

    {
      project.links.length > 0 && (
        <section class="detailSection">
          <h2>Links</h2>
          <div class="chipRow">
            {project.links.map((link) => (
              <a
                class="chipLink"
                href={link.url}
                target="_blank"
                rel="noreferrer"
              >
                {link.label}
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="ctaPanel detailCta" aria-labelledby="project-next-step">
      <div class="stack">
        <p class="eyebrow">Next step</p>
        <h2 class="detailCtaTitle" id="project-next-step">
          Interested in this kind of systems work?
        </h2>
        <p>Review my resume or get in touch directly.</p>
      </div>
      <div class="ctaActions">
        <a
          class="button"
          href={profile.resumeUrl}
          target="_blank"
          rel="noreferrer"
        >
          Open resume
        </a>
        <a class="buttonSecondary" href={`mailto:${profile.email}`}>Email me</a>
      </div>
    </section>

    <a class="inlineLink" href="/projects/"> Back to all projects </a>
  </article>
</BaseLayout>
