---
import { Image } from "astro:assets"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { projectEntries } from "../../data/projects"
import type { ProjectEntry } from "../../types/content"
export function getStaticPaths() {
  return projectEntries.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}
interface Props {
  project: ProjectEntry & { period?: string }
}
const { project } = Astro.props
const related = projectEntries.filter(
  (item) => item.category === project.category
)
const next =
  related[
    (related.findIndex((item) => item.slug === project.slug) + 1) %
      related.length
  ]
const archived = project.category === "archive"
---

<BaseLayout
  meta={{
    title: project.name,
    description: project.summary,
    path: `/projects/${project.slug}/`,
  }}
>
  <article class="project-detail">
    <header class="page-intro">
      <a class="back-link" href={archived ? "/archive/" : "/#work"}
        >{archived ? "← Earlier projects" : "← All AWS work"}</a
      >
      <p class="eyebrow">
        {archived ? "Earlier project" : "AWS Step Functions"}{
          project.period && ` / ${project.period}`
        }
      </p>
      <h1>{project.name}</h1><p class="lead">{project.summary}</p>
    </header>
    {
      project.image && (
        <figure class="project-image">
          <Image
            src={project.image}
            alt={project.imageAlt ?? project.name}
            width={420}
            height={300}
          />
        </figure>
      )
    }
    {
      project.descriptionSections.map((section) => (
        <section class="detail-section">
          <h2>{section.title}</h2>
          {section.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))
    }
    <div class="technologies">
      <h2>Technologies</h2><p>{project.tech.join(" · ")}</p>
    </div>
    {
      project.links.length > 0 && (
        <div class="project-links">
          {project.links.map((link) => (
            <a href={link.url}>{link.label} ↗</a>
          ))}
        </div>
      )
    }
    <nav class="related-work" aria-label="Project navigation">
      <a href={archived ? "/archive/" : "/#work"}
        >{archived ? "← Earlier projects" : "← All AWS work"}</a
      ><a href={`/projects/${next.slug}/`}>Next: {next.name} →</a>
    </nav>
  </article>
</BaseLayout>
