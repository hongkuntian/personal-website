---
import BaseLayout from "../../layouts/BaseLayout.astro"
import AwsCareer from "../../components/AwsCareer.astro"
import { experienceSummary, educationSummary } from "../../data/site-content"
---

<BaseLayout
  meta={{
    title: "AWS experience",
    description: experienceSummary,
    path: "/experience/",
  }}
>
  <header class="page-intro">
    <h1>AWS experience</h1><p class="lead">{experienceSummary}</p>
  </header>
  <AwsCareer /><p class="education">{educationSummary}</p><p>
    <a href="/#work">Explore my AWS work →</a>
  </p>
</BaseLayout>
