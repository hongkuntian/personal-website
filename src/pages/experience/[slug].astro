---
import { experienceEntries } from "../../data/experience"
import BaseLayout from "../../layouts/BaseLayout.astro"
import AwsCareer from "../../components/AwsCareer.astro"
import WorkList from "../../components/WorkList.astro"
import { experienceSummary } from "../../data/site-content"
import { formatDateRange } from "../../utils/content"
export function getStaticPaths() {
  return experienceEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }))
}
const { entry } = Astro.props
const isAws = entry.slug === "aws-step-functions"
---

<BaseLayout
  meta={{
    title: isAws
      ? "AWS Step Functions experience"
      : `${entry.role} at ${entry.company}`,
    description: isAws ? experienceSummary : entry.summary,
    path: `/experience/${entry.slug}/`,
  }}
>
  <header class="page-intro">
    <a class="back-link" href="/#about">← Back to experience</a>
    <h1>{isAws ? "AWS Step Functions" : entry.company}</h1>
    <p class="lead">
      {
        isAws
          ? experienceSummary
          : `${entry.role} · ${formatDateRange(entry.start, entry.end)}`
      }
    </p>
  </header>
  {
    isAws ? (
      <>
        <>
          <AwsCareer />
          <h2>Selected AWS work</h2>
          <WorkList />
        </>
      </>
    ) : (
      <>
        <p>{entry.summary}</p>
        {entry.detailSections.map((section) => (
          <section class="detail-section">
            <h2>{section.title}</h2>
            {section.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))}
      </>
    )
  }
</BaseLayout>
